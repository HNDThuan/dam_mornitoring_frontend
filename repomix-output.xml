                    className="w-full bg-card2 border border-border rounded px-3 py-2 text-tx outline-none focus:border-accent font-mono"
                  />
                </div>
                <div>
                  <Label className="mb-1">Lưu lượng (m3/s)</Label>
                  <input
                    type="number"
                    value={damForm.flow}
